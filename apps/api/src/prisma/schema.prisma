generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestType {
  TEAM_NEEDS_PLAYER
  PLAYER_NEEDS_TEAM
}

enum Position {
  GOALIE
  DEFENSE
  FORWARD
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

model Request {
  id           Int        @id @default(autoincrement())
  type         RequestType
  position     Position
  skillLevel   SkillLevel

  payAmount    Int?
  teamName     String?
  playerName   String?

  arena        String
  arenaAddress String?
  time         String
  notes        String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([type])
  @@index([position, skillLevel])
}

model PlayerOffer {
  id           Int        @id @default(autoincrement())
  playerName   String
  position     Position
  skillLevel   SkillLevel
  payAmount    Int
  arena        String
  arenaAddress String
  time         String
  notes        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}