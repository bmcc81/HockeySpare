generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Request {
  arena        String
  notes        String?
  position     Position
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  arenaAddress String?
  payAmount    Int?
  playerName   String?
  skillLevel   SkillLevel
  teamName     String?
  time         String
  type         RequestType
  id           Int         @id @default(autoincrement())

  @@index([type])
  @@index([position, skillLevel])
}

model PlayerOffer {
  arena        String
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  arenaAddress String
  payAmount    Int
  playerName   String
  time         String
  id           Int        @id @default(autoincrement())
  position     Position
  skillLevel   SkillLevel
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  firstName    String?
  lastName     String?
}

enum RequestType {
  TEAM_NEEDS_PLAYER
  PLAYER_NEEDS_TEAM
}

enum Position {
  GOALIE
  DEFENSE
  FORWARD
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}
