generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Request {
  id           Int           @id @default(autoincrement())
  userId       String
  arena        String
  notes        String?
  position     Position
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  arenaAddress String?
  payAmount    Int?
  playerName   String?
  skillLevel   SkillLevel
  teamName     String?
  time         String
  type         RequestType
  status       RequestStatus @default(OPEN)

  user         User          @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([position, skillLevel])
  @@index([userId, status])
}

model RequestResponse {
  id            Int                  @id @default(autoincrement())
  requestId      Int
  responderUserId String
  message        String?
  status         ResponseStatus      @default(PENDING)
  createdAt      DateTime            @default(now())

  request        Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder      User                @relation(fields: [responderUserId], references: [id], onDelete: Cascade)

  @@index([requestId, responderUserId])
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model PlayerOffer {
  id           Int          @id @default(autoincrement())
  userId       String
  arena        String
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  arenaAddress String?
  payAmount    Int?
  playerName   String
  time         String
  position     Position
  skillLevel   SkillLevel
  status       OfferStatus  @default(OPEN)

  user         User         @relation("UserOffers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([position, skillLevel])
  @@index([userId, status])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  firstName     String?
  lastName      String?

  requests      Request[]      @relation("UserRequests")
  playerOffers  PlayerOffer[]  @relation("UserOffers")
  notifications Notification[]
}

enum RequestType {
  TEAM_NEEDS_PLAYER
  PLAYER_NEEDS_TEAM
}

enum Position {
  GOALIE
  DEFENSE
  FORWARD
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

enum OfferStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

enum NotificationType {
  REQUEST_MATCH
  OFFER_MATCH
  REQUEST_RESPONSE
  REQUEST_ACCEPTED
  REQUEST_DECLINED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

