generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  ADMIN
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamRole {
  PLAYER
  CAPTAIN
  GENERAL_MANAGER
}

enum LeagueRole {
  PLAYER
  TEAM_MANAGER
  LEAGUE_MANAGER
  TIMEKEEPER
}

enum TeamGameAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  NEED_SPARE
}

enum RequestType {
  TEAM_NEEDS_PLAYER
  PLAYER_NEEDS_TEAM
}

enum Position {
  GOALIE
  DEFENSE
  FORWARD
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum RequestStatus {
  OPEN
  FILLED
  CANCELLED
}

enum OfferStatus {
  OPEN
  FILLED
  CANCELLED
}

enum NotificationType {
  REQUEST_MATCH
  OFFER_MATCH
  REQUEST_RESPONSE
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  TEAM_GAME_REMINDER
  TEAM_MEMBER_ADDED
}

enum TeamMemberType {
  REGULAR
  SPARE
}

enum TeamGameInviteStatus {
  PENDING
  SENT
  CONFIRMED
  DECLINED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

model Request {
  id           Int           @id @default(autoincrement())
  userId       String
  arena        String
  notes        String?
  position     Position
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  arenaAddress String?
  payAmount    Int?
  playerName   String?
  skillLevel   SkillLevel
  teamName     String?
  date         DateTime
  time         String
  type         RequestType
  status       RequestStatus @default(OPEN)
  teamGameId   String?

  user      User              @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  teamGame  TeamGame?         @relation(fields: [teamGameId], references: [id], onDelete: SetNull)
  responses RequestResponse[]
  bookings  Booking[]

  @@index([type])
  @@index([position, skillLevel])
  @@index([userId, status])
  @@index([teamGameId])
}

model RequestResponse {
  id              Int            @id @default(autoincrement())
  requestId       Int
  responderUserId String
  message         String?
  status          ResponseStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder User    @relation(fields: [responderUserId], references: [id], onDelete: Cascade)

  @@index([requestId, responderUserId])
}

model PlayerOffer {
  id           Int         @id @default(autoincrement())
  userId       String
  arena        String
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  arenaAddress String?
  payAmount    Int?
  playerName   String
  date         DateTime
  time         String
  position     Position
  skillLevel   SkillLevel
  status       OfferStatus @default(OPEN)

  user User @relation("UserOffers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([position, skillLevel])
  @@index([userId, status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  firstName    String?
  lastName     String?
  appRole      AppRole  @default(USER)

  requests         Request[]         @relation("UserRequests")
  playerOffers     PlayerOffer[]     @relation("UserOffers")
  notifications    Notification[]
  requestResponses RequestResponse[]
  bookings         Booking[]

  finalizedScoreSheets GameScoreSheet[]

  createdTeams       Team[]         @relation("CreatedTeams")
  teamMemberships    TeamMember[]   @relation("UserTeamMemberships")
  leagueMemberships  LeagueMember[]
  playerStats        PlayerStat[]
  memberFees         MemberFee[]
  createdTournaments Tournament[]   @relation("CreatedTournaments")
}

model League {
  id        String   @id @default(cuid())
  name      String
  season    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scoreSheets GameScoreSheet[]

  teams       Team[]
  members     LeagueMember[]
  playerStats PlayerStat[]
  memberFees  MemberFee[]
  arenas      LeagueArena[]
  games       TeamGame[]
  tournaments Tournament[]
}

model LeagueArena {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  games  TeamGame[]

  @@unique([leagueId, name])
  @@index([leagueId])
}

model LeagueMember {
  id        String     @id @default(cuid())
  leagueId  String
  userId    String
  role      LeagueRole @default(PLAYER)
  createdAt DateTime   @default(now())

  scoreSheet GameScoreSheet? @relation(fields: [gameScoreSheetId], references: [id])

  league           League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameScoreSheetId String?

  @@unique([leagueId, userId])
  @@index([leagueId, role])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  createdById String?  @map("ownerId")
  leagueId    String?
  joinCode    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scoreSheets GameScoreSheet[]

  createdBy     User?        @relation("CreatedTeams", fields: [createdById], references: [id], onDelete: SetNull)
  league        League?      @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  games         TeamGame[]   @relation("TeamGameTeam")
  opponentGames TeamGame[]   @relation("TeamGameOpponentTeam")
  playerStats   PlayerStat[]
  memberFees    MemberFee[]

  @@index([leagueId])
}

model TeamMember {
  id            String         @id @default(cuid())
  teamId        String
  userId        String?
  displayName   String
  email         String?
  phone         String?
  position      Position?
  memberType    TeamMemberType
  role          TeamRole       @default(PLAYER)
  notifyByApp   Boolean        @default(true)
  notifyByEmail Boolean        @default(false)
  notifyBySms   Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  team                  Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                  User?                  @relation("UserTeamMemberships", fields: [userId], references: [id], onDelete: SetNull)
  invites               TeamGameInvite[]
  availabilities        TeamGameAvailability[]
  playerStats           PlayerStat[]
  memberFees            MemberFee[]
  gameScoreSheetPlayers GameScoreSheetPlayer[]

  @@index([teamId, memberType])
  @@index([teamId, role])
}

model PlayerStat {
  id          String   @id @default(cuid())
  memberId    String
  userId      String?
  teamId      String
  leagueId    String?
  season      String
  gamesPlayed Int      @default(0)
  goals       Int      @default(0)
  assists     Int      @default(0)
  penaltyMins Int      @default(0)
  plusMinus   Int      @default(0)
  updatedAt   DateTime @updatedAt

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League?    @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  @@unique([memberId, season])
  @@index([teamId])
  @@index([leagueId])
  @@index([userId])
}

model MemberFee {
  id          String   @id @default(cuid())
  memberId    String
  userId      String?
  teamId      String
  leagueId    String?
  season      String
  amountOwed  Int      @default(0)
  amountPaid  Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League?    @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  @@unique([memberId, season])
  @@index([teamId])
  @@index([leagueId])
  @@index([userId])
}

model TeamGame {
  id             String   @id @default(cuid())
  leagueId       String?
  teamId         String
  opponentTeamId String?
  arenaId        String?
  title          String
  startsAt       DateTime
  opponent       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  league       League?      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team         Team         @relation("TeamGameTeam", fields: [teamId], references: [id], onDelete: Cascade)
  opponentTeam Team?        @relation("TeamGameOpponentTeam", fields: [opponentTeamId], references: [id], onDelete: SetNull)
  arena        LeagueArena? @relation(fields: [arenaId], references: [id], onDelete: SetNull)

  invites        TeamGameInvite[]
  availabilities TeamGameAvailability[]
  gameScoreSheet GameScoreSheet?
  autoRequests   Request[]

  @@index([leagueId, startsAt])
  @@index([teamId, startsAt])
  @@index([opponentTeamId, startsAt])
  @@index([arenaId])
}

model TeamGameInvite {
  id          String               @id @default(cuid())
  gameId      String
  memberId    String
  status      TeamGameInviteStatus @default(PENDING)
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime             @default(now())

  game   TeamGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([gameId, memberId])
}

model TeamGameAvailability {
  id        String                     @id @default(cuid())
  gameId    String
  memberId  String
  status    TeamGameAvailabilityStatus @default(AVAILABLE)
  note      String?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  game   TeamGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([gameId, memberId])
  @@index([gameId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Booking {
  id              String   @id @default(cuid())
  requestId       Int
  userId          String
  status          String   @default("PENDING")
  message         String?
  responseMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
}

enum ScoreSheetStatus {
  DRAFT
  FINALIZED
}

model GameScoreSheet {
  id       String @id @default(cuid())
  gameId   String @unique
  leagueId String
  teamId   String

  teamScore     Int @default(0)
  opponentScore Int @default(0)

  teamPeriod1Score     Int @default(0)
  teamPeriod2Score     Int @default(0)
  teamPeriod3Score     Int @default(0)
  teamOvertimeScore    Int @default(0)

  opponentPeriod1Score  Int @default(0)
  opponentPeriod2Score  Int @default(0)
  opponentPeriod3Score  Int @default(0)
  opponentOvertimeScore Int @default(0)

  status        ScoreSheetStatus @default(DRAFT)
  finalizedAt   DateTime?
  finalizedById String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game        TeamGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  finalizedBy User?    @relation(fields: [finalizedById], references: [id])

  playerLines   GameScoreSheetPlayer[]
  leagueMembers LeagueMember[]
}

model GameScoreSheetPlayer {
  id           String @id @default(cuid())
  scoreSheetId String
  memberId     String

  gamesPlayed Int @default(1)
  goals       Int @default(0)
  assists     Int @default(0)
  penaltyMins Int @default(0)
  plusMinus   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scoreSheet GameScoreSheet @relation(fields: [scoreSheetId], references: [id], onDelete: Cascade)
  member     TeamMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([scoreSheetId, memberId])
}

model HelpArticle {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  category  String?
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TournamentGameStatus {
  SCHEDULED
  LIVE
  FINAL
}

model Tournament {
  id          String    @id @default(cuid())
  name        String
  description String?
  rules       String?
  startDate   DateTime?
  endDate     DateTime?
  leagueId    String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  league        League?                  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  createdBy     User                     @relation("CreatedTournaments", fields: [createdById], references: [id], onDelete: Cascade)
  games         TournamentGame[]
  registrations TournamentRegistration[]
  sponsors      TournamentSponsor[]

  @@index([leagueId])
  @@index([createdById])
}

model TournamentGame {
  id           String               @id @default(cuid())
  tournamentId String
  homeTeamName String
  awayTeamName String
  startsAt     DateTime
  arenaName    String?
  notes        String?
  homeScore    Int?
  awayScore    Int?
  status       TournamentGameStatus @default(SCHEDULED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, startsAt])
}

model TournamentRegistration {
  id           String   @id @default(cuid())
  tournamentId String
  teamName     String
  division     String?
  contactName  String
  contactEmail String
  contactPhone String?
  notes        String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
}

model TournamentSponsor {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  logoUrl      String?
  linkUrl      String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, createdAt])
}
