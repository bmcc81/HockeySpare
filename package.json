{
  "name": "hockeyspare-monorepo",
  "private": true,
  "scripts": {
    "build:contracts": "npm run --workspace @hockeyspare/contracts build",
    "watch:contracts": "npm run --workspace @hockeyspare/contracts watch",
    "web": "cd apps/web && ng serve --configuration development",
    "api": "cd apps/api && npm run start:dev",
    "studio": "cd apps/api && npx prisma studio",
    "dev": "npm run build:contracts && concurrently \"npm run watch:contracts\" \"npm run web\" \"npm run api\" \"npm run studio\""
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.28.1",
    "concurrently": "^9.2.1",
    "prisma": "^7.4.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@prisma/client": "^7.4.0"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "1.19.11",
      "hono": "4.12.7",
      "lodash": "4.17.23"
    }
  }
}
